# Copy to .env (make install does this). Never commit .env.

# OpenAI: optional. Without it (or with OFFLINE=1) everything runs on the
# deterministic mock LLM and mock judge.
OPENAI_API_KEY=
# OFFLINE=1 forces offline, OFFLINE=0 forces live. Unset = offline when no key.
OFFLINE=

# Models (decision A8). Defaults shown.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_JUDGE_MODEL=gpt-4.1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Langfuse v4 (Module 9). Without keys, traces are captured in memory and printed.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# Optional threshold overrides: EVAL_THRESHOLD_<METRIC>=0.8
# EVAL_THRESHOLD_FAITHFULNESS=0.85
