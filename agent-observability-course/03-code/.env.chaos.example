# Lab 4 reference "chaos" settings (copy to .env.chaos). Real variables only; see src/northwind/config.py.
# Offline, the mock LLM honours ATLAS_REQUEST_TIMEOUT_S (a call slower than it raises
# APITimeoutError), and slow_provider slows only the primary deployment (the gpt-4.1 family), so the
# timeout -> retry -> circuit breaker -> fallback (gpt-4o-mini) path is measurable offline:
#   BUDGET_GATE_INCIDENTS=slow_provider ATLAS_REQUEST_TIMEOUT_S=4 ATLAS_MAX_RETRIES=2 \
#     ATLAS_ROUTER_ALLOWED_FAILS=2 ATLAS_ROUTER_COOLDOWN_S=1800 make budget-check     -> 5 passed
# Keep ATLAS_ROUTER_ALLOWED_FAILS <= ATLAS_MAX_RETRIES: then the breaker opens while the request still
# has an attempt left, and that attempt goes to the fallback instead of ending in `error`.
# A short cooldown re-probes the slow deployment often, and every probe is a slow request.
OFFLINE=1
ATLAS_SCENARIO=slow_provider          # TTFT x3.5, tokens/s halved on the gpt-4.1 family (make run) — replay: SCENARIO=slow_provider
ATLAS_REQUEST_TIMEOUT_S=4             # per model call (default 20): about 2x the slowest normal call
ATLAS_MAX_RETRIES=2                   # retries per model call (default 2)
ATLAS_ROUTER_MODE=1                   # LiteLLM Router with fallbacks online; small-model-first routing offline
ATLAS_ROUTER_ALLOWED_FAILS=2          # failures before the breaker opens / Router allowed_fails (default 3)
ATLAS_ROUTER_COOLDOWN_S=1800          # seconds the slow deployment is skipped / Router cooldown_time (default 30)
ATLAS_TENANT_MAX_INFLIGHT=8           # per-tenant concurrency slots (default ops=13,eng=7,finance=6,hr=6,other=2)
ATLAS_QUEUE_TIMEOUT_S=3               # wait for a slot, then 429 + Retry-After (default 3)
