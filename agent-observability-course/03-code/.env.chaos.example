# Lab 4 reference "chaos" settings (copy to .env.chaos). Real variables only; see src/northwind/config.py.
# Offline, the replay drives the mock LLM directly: timeouts/retries/router apply to `make run`
# against a real provider (OFFLINE=0). The scenario and the concurrency cap work offline too.
OFFLINE=1
ATLAS_SCENARIO=slow_provider          # TTFT x3.5, tokens/s halved (make run) — replay: SCENARIO=slow_provider
ATLAS_REQUEST_TIMEOUT_S=4             # per model call (default 20)
ATLAS_MAX_RETRIES=1                   # retries per model call (default 2)
ATLAS_ROUTER_MODE=1                   # LiteLLM Router with fallbacks (build_router_config)
ATLAS_ROUTER_ALLOWED_FAILS=2          # Router allowed_fails (default 3)
ATLAS_ROUTER_COOLDOWN_S=120           # Router cooldown_time (default 30)
ATLAS_TENANT_MAX_INFLIGHT=8           # per-tenant concurrency slots (default ops=13,eng=7,finance=6,hr=6,other=2)
ATLAS_QUEUE_TIMEOUT_S=3               # wait for a slot, then 429 + Retry-After (default 3)
