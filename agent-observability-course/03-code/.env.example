# ---- Atlas runtime -------------------------------------------------------
# 1 = deterministic mock LLM, no network, local SQLite/JSONL store (default in tests)
OFFLINE=1
ATLAS_MODEL=gpt-4.1-mini
ATLAS_ESCALATION_MODEL=gpt-4.1
ATLAS_ROUTING_MODEL=gpt-5-mini
ATLAS_JUDGE_MODEL=gpt-4.1-mini
ATLAS_PROMPT_VERSION=v1            # v1 | v2  (v2 is the Incident 3 regression)
ATLAS_MAX_STEPS=6
ATLAS_TOP_K=4
ATLAS_PROMPT_CACHE=1               # send prompt_cache_key
ATLAS_CONTEXT_DIET=1               # trim history + truncate tool results
ATLAS_HISTORY_TOKENS=8000          # context diet: history budget
ATLAS_TOOL_RESULT_TOKENS=1400      # context diet: per tool result budget
ATLAS_MAX_TOOL_RETRIES=0           # 0 = unlimited (Lecture 5.6 sets 2)
ATLAS_PROMPT_LABEL=production      # Langfuse prompt label to fetch
ATLAS_STREAM=1                     # stream completions (TTFT capture)
KB_MIN_SCORE=0.5                   # BM25 relevance floor for retrieval
ATLAS_ROUTER_MODE=0                # 1 = LiteLLM Router (small-model-first + fallbacks)
ATLAS_REQUEST_TIMEOUT_S=20
ATLAS_MAX_RETRIES=2
ATLAS_SCENARIO=                    # loop | context_bloat | retry_storm | slow_provider | prompt_regression
ATLAS_LOCAL_STORE=.atlas/spans.sqlite
LOG_LEVEL=INFO

# ---- OpenAI (only when OFFLINE=0) -----------------------------------------
OPENAI_API_KEY=sk-...

# ---- Langfuse (optional; leave empty to disable) ---------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or http://localhost:3000 for self-hosted
LANGFUSE_TRACING_ENVIRONMENT=dev
LANGFUSE_RELEASE=v1.0.0
LANGFUSE_SAMPLE_RATE=1.0

# ---- OpenTelemetry ---------------------------------------------------------
# console | otlp | file | langfuse | none | memory
OTEL_EXPORTER=console
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=atlas
DEPLOYMENT_ENVIRONMENT=dev
TRACE_SAMPLE_RATE=1.0
JUDGE_SAMPLE_RATE=0.1

# ---- Budgets (used by budget.py and tests/budget/test_budget_gate.py) -----
BUDGET_COST_PER_SESSION_USD=0.05
BUDGET_P95_LATENCY_MS=4000
TENANT_SOFT_CAP_USD=25
TENANT_HARD_CAP_USD=40

# ---- LangSmith (Section 12, optional) -------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=atlas
