# Copy to .env and fill in. Never commit .env.
# `lk app env` (LiveKit CLI) can write the LIVEKIT_* values for you.

# --- LiveKit (required for console with real models, dev, start) ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Agent name for explicit dispatch (telephony, outbound calls, deployment).
# Leave it UNSET for Sections 3-7: a named agent is not auto-dispatched to the
# Agents Playground. Set it from Section 8 on (or use [agent] name in livekit.toml,
# which is only read by `start`).
# LIVEKIT_AGENT_NAME=riley-receptionist

# --- Provider keys --------------------------------------------------------
# With MAPLE_PROVIDER_MODE=inference (default) STT/LLM/TTS run through LiveKit
# Inference and bill to your LiveKit project; these keys are then only needed by
# tests, evals, the realtime agent and Pipecat.
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

# --- Models (src/maple/config.py) -----------------------------------------
# inference | plugins
MAPLE_PROVIDER_MODE=inference
STT_MODEL=deepgram/nova-3
LLM_MODEL=openai/gpt-4.1-mini
TTS_MODEL=cartesia/sonic-3
TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
FALLBACK_LLM_MODEL=google/gemini-2.5-flash
FALLBACK_STT_MODEL=assemblyai/universal-streaming
FALLBACK_TTS_MODEL=deepgram/aura-2
# tests and evals (OpenAI plugin)
JUDGE_MODEL=gpt-4.1-mini

# --- Behaviour ------------------------------------------------------------
# 1 = scripted fake LLM, no STT/TTS; use `console --text`
MOCK_MODE=0
# en | es | hi
LANGUAGE=en
# fixed "today" for demos and recordings; delete for real dates
MAPLE_TODAY=2026-10-05
MIN_ENDPOINTING_DELAY=0.5
MAX_ENDPOINTING_DELAY=3.0
# seconds; >0 makes tools slow so you hear filler speech
MAPLE_SIMULATED_LATENCY=0
CLINIC_TIMEZONE=America/Chicago

# --- Telephony (Section 8) --------------------------------------------------
# where transfer_to_human sends callers (E.164)
TRANSFER_PHONE_NUMBER=+15125550100
# ST_xxx from `lk sip outbound create`
SIP_OUTBOUND_TRUNK_ID=

# --- Observability (Section 10) --------------------------------------------
METRICS_DIR=metrics
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Evals ------------------------------------------------------------------
DEEPEVAL_TELEMETRY_OPT_OUT=YES
